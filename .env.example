# Demo is OFF by default. Keep false in production.
ENABLE_DEMO_RESULT=false

# Authorized/licensed JSON result providers.
# Add real secrets in Vercel Project Settings > Environment Variables.
# Never commit real keys to GitHub.
# Each board can have its own HTTPS JSON endpoint and Bearer key.
# The public /api/result endpoint accepts board, className, year, exam,
# searchType and search, then calls only the configured authorized provider.

RESULT_PROVIDER_BISE_LAHORE_URL=
RESULT_PROVIDER_BISE_LAHORE_KEY=
