# Demo is OFF by default. Keep false in production.
ENABLE_DEMO_RESULT=false

# Authorized/licensed JSON result providers.
# Add real secrets in Vercel Project Settings > Environment Variables.
# Never commit real keys to GitHub.
#
# Generic board pattern:
# RESULT_PROVIDER_<BOARD_SLUG>_URL=
# RESULT_PROVIDER_<BOARD_SLUG>_KEY=
#
# Examples:
# RESULT_PROVIDER_BISE_LAHORE_URL=https://authorized-provider.example/result
# RESULT_PROVIDER_BISE_LAHORE_KEY=
# RESULT_PROVIDER_FEDERAL_BOARD_FBISE_URL=https://authorized-provider.example/result
# RESULT_PROVIDER_FEDERAL_BOARD_FBISE_KEY=
